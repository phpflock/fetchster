{
  "manifest_version": 2,
  "name": "Fetchster Safari",
  "version": "1.0.0",
  "description": "Send downloads to the Fetchster macOS menu bar app from Safari.",
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Fetchster",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
